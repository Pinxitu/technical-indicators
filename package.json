{
  "name": "@tradingcompendium/technical-indicators",
  "version": "0.1.0",
  "description": "Dependency-free TypeScript implementations of the technical indicators documented at tradingcompendium.com, with hand-verifiable tests and open datasets.",
  "license": "MIT",
  "author": "Trading Compendium Editorial Team <contacto@tradingcompendium.com> (https://tradingcompendium.com)",
  "homepage": "https://tradingcompendium.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pinxitu/technical-indicators.git"
  },
  "keywords": [
    "technical-analysis",
    "indicators",
    "rsi",
    "macd",
    "bollinger-bands",
    "atr",
    "adx",
    "ichimoku",
    "supertrend",
    "trading",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/fetch-data.mjs",
    "evidence": "node evidence/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
